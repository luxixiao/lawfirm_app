<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- T2 命令行入口：只读打开 lawfirm.db，跑结算引擎 + NPOI 导出，产出可供 diff 的 xlsx -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>LawFirm.Cli</RootNamespace>
    <AssemblyName>LawFirm.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LawFirm.Data\LawFirm.Data.csproj" />
    <ProjectReference Include="..\LawFirm.Exporter\LawFirm.Exporter.csproj" />
  </ItemGroup>

</Project>
