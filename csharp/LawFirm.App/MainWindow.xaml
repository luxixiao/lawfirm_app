<Window x:Class="LawFirm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LawFirm · T2 只读验证（Dapper + SQLite）"
        Height="640" Width="960">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="InvoiceCountText"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="发票表（invoice）前 5 行样例" Margin="0,0,0,2" />
        <DataGrid Grid.Row="2" x:Name="InvoiceGrid"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  HeadersVisibility="Column" MaxHeight="240" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" x:Name="CollectionCountText"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock Grid.Row="4" Text="收款明细表（collection）前 5 行样例" Margin="0,0,0,2" />
        <DataGrid Grid.Row="5" x:Name="CollectionGrid"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  HeadersVisibility="Column" MaxHeight="240" Margin="0,0,0,8" />

        <TextBlock Grid.Row="6" x:Name="StatusText"
                   TextWrapping="Wrap" FontSize="12" />
    </Grid>
</Window>
