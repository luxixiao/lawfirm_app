<Application x:Class="LawFirm.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LawFirm.App">
    <!--
      T5：不再用 StartupUri（启动顺序显式化，规格 §2.2-3）；
      MainShellWindow 由 App.OnStartup 创建。
      资源合并顺序：Palette → Typography → NotionControls（后者引用前两者的 key）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LawFirm.UI;component/Themes/Palette.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/LawFirm.UI;component/Themes/Typography.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/LawFirm.UI;component/Themes/NotionControls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/LawFirm.UI;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
