<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF 单目标先启（计划 §1.2 / §3.1 Pilot 用 net10 单目标；Win7 后门推迟到全量期） -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LawFirm.App</RootNamespace>
    <AssemblyName>LawFirm.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- T5：App 保留唯一 WinExe 入口，产品 UI 全部在 LawFirm.UI（规格 §2.1） -->
    <ProjectReference Include="..\LawFirm.UI\LawFirm.UI.csproj" />
    <ProjectReference Include="..\LawFirm.Data\LawFirm.Data.csproj" />
  </ItemGroup>

</Project>
