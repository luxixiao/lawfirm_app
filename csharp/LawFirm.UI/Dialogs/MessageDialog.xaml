<Window x:Class="LawFirm.UI.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="420" Topmost="False"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}">
    <!--
      Notion 风消息对话框（T5.4-④，替代 QMessageBox）：标题 + 内容 + 确定按钮。
      Border 圆角 10 + 描边 {Border}（视觉对齐 ProgressWindow）。
    -->
    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="10" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" FontSize="{StaticResource FontDialogTitleSize}"
                       FontWeight="Bold" Foreground="{StaticResource Text}" Text="提示"/>
            <TextBlock x:Name="BodyText" Margin="0,12,0,0" TextWrapping="Wrap"
                       FontSize="{StaticResource FontBaseSize}"
                       Foreground="{StaticResource Text}" Text=""/>
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Margin="0,20,0,0"
                    MinWidth="88" Click="OnOk"/>
        </StackPanel>
    </Border>
</Window>
