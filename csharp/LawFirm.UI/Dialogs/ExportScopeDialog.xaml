<Window x:Class="LawFirm.UI.Dialogs.ExportScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要导出的经办人" Width="360" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource AppFontFamily}">
    <!--
      多选经办人弹窗（对应 gen_selected 的 QDialog，settlement_view.py:365-405）：
      提示 + 可勾选名单 + 全选 + 确定/取消。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource CaptionLabel}"
                   Text="{Binding Tip}"/>

        <ListBox Grid.Row="1" x:Name="PersonList" Margin="0,10,0,0"
                 Background="{StaticResource Bg}"
                 BorderBrush="{StaticResource Border2}" BorderThickness="1"
                 ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Margin="8,4"
                              FontFamily="{StaticResource AppFontFamily}"
                              FontSize="{StaticResource FontBaseSize}"
                              Foreground="{StaticResource Text}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="全选" VerticalAlignment="Center"
                      FontFamily="{StaticResource AppFontFamily}"
                      Foreground="{StaticResource Text}"
                      Checked="OnToggleAll" Unchecked="OnToggleAll"/>
            <Button Grid.Column="2" Content="取消" Style="{StaticResource NotionButton}"
                    MinWidth="80" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButton}"
                    MinWidth="80" Click="OnOk"/>
        </Grid>
    </Grid>
</Window>
