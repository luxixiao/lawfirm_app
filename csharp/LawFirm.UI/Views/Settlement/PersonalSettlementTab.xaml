<UserControl x:Class="LawFirm.UI.Views.Settlement.PersonalSettlementTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LawFirm.UI.Controls">
    <!--
      Tab1 个人结算总表（规格 §5.1/§5.2 骨架，对齐 settlement_view.py:53-151）：
      行0 筛选栏（年份/经办人/月份/类型）→ 行1 表格（动态列，冻结首列）→
      行2 导出三按钮 + 摘要 → 行3 生成日志（MaxHeight=120）。
    -->
    <Grid Margin="8,10,8,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 行0: 筛选栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Style="{StaticResource CaptionLabel}" Text="年份" Margin="0,0,6,0"/>
            <ComboBox Style="{StaticResource NotionCombo}" MinWidth="90"
                      ItemsSource="{Binding Years}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding Year, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource CaptionLabel}" Text="经办人" Margin="12,0,6,0"/>
            <ComboBox Style="{StaticResource NotionCombo}" MinWidth="150"
                      ItemsSource="{Binding Persons}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding Person, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource CaptionLabel}" Text="月份" Margin="12,0,6,0"/>
            <ComboBox Style="{StaticResource NotionCombo}" MinWidth="90"
                      ItemsSource="{Binding Months}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding Month, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource CaptionLabel}" Text="类型" Margin="12,0,6,0"/>
            <ComboBox Style="{StaticResource NotionCombo}" MinWidth="90"
                      ItemsSource="{Binding Types}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding PersonType, Mode=TwoWay}"/>
        </StackPanel>

        <!-- 行1: 表格（动态列由代码后置按 VM.ColumnsChanged 重建） -->
        <controls:NotionDataGrid x:Name="Grid" Grid.Row="1" Margin="0,10,0,0"
                                 Style="{StaticResource NotionDataGridStyle}"
                                 FrozenColumnCount="1"
                                 ColumnHeaderHeight="34"
                                 ItemsSource="{Binding Rows}"/>

        <!-- 行2: 按钮 + 摘要 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="导出全部员工"
                        Command="{Binding ExportAllCommand}"/>
                <Button Style="{StaticResource NotionButton}" Content="导出指定人员"
                        Margin="10,0,0,0"
                        Command="{Binding ExportSelectedCommand}"/>
                <Button Style="{StaticResource NotionButton}" Content="导出月度结算表"
                        Margin="10,0,0,0"
                        Command="{Binding ExportMonthlyCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionLabel}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding SummaryText}"/>
        </Grid>

        <!-- 行3: 生成日志 -->
        <TextBox Grid.Row="3" Style="{StaticResource LogBox}" MaxHeight="120"
                 Margin="0,10,0,0"
                 IsReadOnly="True" Text="{Binding LogText, Mode=OneWay}"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
