<UserControl x:Class="LawFirm.UI.Shell.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:LawFirm.UI.Shell"
             xmlns:services="clr-namespace:LawFirm.UI.Services">
    <!--
      分组折叠侧栏（规格 §3.3，对齐 sidebar.py 方案 A）：
      - 宽 240（展开）/ 60（收起），宽度动画由代码后置驱动（收 240ms OutQuart / 展 180ms OutCubic）
      - 组行高 34 / 子项行高 31 / 子项左 padding 36 / 图标 20px（V3-V6）
      - 分组展开用 MaxHeight 动画（Auto 不可动画），组面板 Opacity 同步
      - 收起态：仅显组图标（20px 居中），子项面板隐藏；点组头先展开侧栏
      - U2 已裁定：T5 不做 hover 自动展开/收回（固定展开 + 手动折叠）
    -->
    <Border x:Name="RootBorder" Width="240"
            Background="{StaticResource BgSide}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 折叠按钮（Row0） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,4">
                <Button x:Name="CollapseButton" Focusable="False" Cursor="Hand"
                        ToolTip="折叠 / 展开侧栏" Click="OnToggleCollapse">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                                    Padding="6,4">
                                <Path x:Name="Glyph"
                                      Stroke="{StaticResource TextMute}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Data="{x:Static shell:NavIcons.ChevronRight}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <!-- 收起态：箭头转向左（侧栏即将展开） -->
                                <DataTrigger Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter TargetName="Glyph" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="CollapseHint" Style="{StaticResource CaptionLabel}" Margin="6,0,0,0"
                           Text="固定"/>
            </StackPanel>

            <!-- 分组列表（Row1） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupsHost" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 组头：ToggleButton，IsChecked 双向绑 NavGroup.IsExpanded -->
                                <ToggleButton Focusable="False" Cursor="Hand" Height="34"
                                              HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Click="OnGroupHeaderClick">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Root" Background="Transparent"
                                                    Padding="12,0,10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 图标 20px -->
                                                    <Path Grid.Column="0" Width="20" Height="20"
                                                          Stretch="Uniform"
                                                          Data="{Binding Icon}"
                                                          Stroke="{StaticResource TextMute}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="GroupText" Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource AppFontFamily}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextMute}"
                                                               Text="{Binding Title}"/>
                                                    <Path x:Name="Chevron" Grid.Column="3"
                                                          Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Data="{x:Static shell:NavIcons.ChevronRight}"
                                                          Stroke="{StaticResource TextFaint}"
                                                          StrokeThickness="1.5" Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BgHover}"/>
                                                    <Setter TargetName="GroupText" Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <!-- 收起态（图标列）：隐藏组名与 chevron -->
                                                <DataTrigger Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter TargetName="GroupText" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 组面板（MaxHeight + Opacity 动画，规格 §3.3） -->
                                <ItemsControl x:Name="GroupPanel" ItemsSource="{Binding Items}"
                                              MaxHeight="0" Opacity="0" Margin="0,0,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 子项：RadioButton 单选语义（选中底 #e3e1db + 字重 600，V6） -->
                                            <RadioButton Focusable="False" Cursor="Hand"
                                                         GroupName="SidebarNavItems"
                                                         Height="31"
                                                         HorizontalContentAlignment="Stretch"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Checked="OnItemChecked">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="Root" Background="Transparent"
                                                                Padding="36,0,10,0">
                                                            <TextBlock x:Name="ItemText"
                                                                       Text="{Binding Title}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{StaticResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextMute}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BgHover}"/>
                                                                <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource Text}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BgSelect}"/>
                                                                <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource Text}"/>
                                                                <Setter TargetName="ItemText" Property="FontWeight" Value="SemiBold"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 分组展开/收起动画（group_in 220ms / group_out 160ms，规格 §3.3） -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GroupPanel"
                                                                 Storyboard.TargetProperty="MaxHeight"
                                                                 To="400" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuarticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="GroupPanel"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GroupPanel"
                                                                 Storyboard.TargetProperty="MaxHeight"
                                                                 To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="GroupPanel"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <!-- 收起态（图标列）：整块子项面板收起。
                                     只隐藏组名是不够的——子项行仍会渲染：窄宽度下文字被压成单字
                                     （"导…/导…/修…"），且这些行继续撑高内容触发竖向滚动条，
                                     滚动条再吃掉 17px 宽 → 文字被彻底裁掉、只剩选中底色块。 -->
                                <DataTrigger Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter TargetName="GroupPanel" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部数据库状态（R-M2 可观测性）：常驻显示当前 lawfirm.db 文件名，
                 悬浮看完整路径 / 来源 / 查找过程，点击复制路径。
                 三机 Seafile 同步下，残留 LAWFIRM_DB 会把程序静默指到旧副本，
                 有这一行就能一眼看出「读的是不是我以为的那个库」。 -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    Padding="12,6,10,6" Cursor="Hand"
                    MouseLeftButtonUp="OnDbPathClick"
                    ToolTipService.ShowDuration="60000"
                    ToolTip="{Binding Source={x:Static services:DbStatusService.Current}, Path=Detail}">
                <Grid>
                    <TextBlock x:Name="DbText"
                               Text="{Binding Source={x:Static services:DbStatusService.Current}, Path=Display}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionLabel}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Style.Triggers>
                                    <!-- 未找到 / 库不可用：标红，避免静默读空 -->
                                    <DataTrigger Binding="{Binding Source={x:Static services:DbStatusService.Current}, Path=IsOk}" Value="False">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <!-- 收起态（图标列）：只留一个点，悬浮仍可看路径 -->
                                    <DataTrigger Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock x:Name="DbDot" Text="●" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionLabel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static services:DbStatusService.Current}, Path=IsOk}" Value="False">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
