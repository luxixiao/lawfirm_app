<UserControl x:Class="LawFirm.UI.Shell.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36"
             KeyboardNavigation.TabNavigation="None">
    <!--
      自绘标题栏（规格 §3.2，对齐 main_window.py:105-171）：
      - 左：当前页名（13px，TextTrimming 防止拉窄时压到按钮，验收 T5.1-⑦）
      - 右：最小化 / 最大化 / 关闭 三按钮 46x36，hover rgba(0,0,0,0.10)，关闭 hover #E81123 白字
      - 拖拽：由 MainShellWindow 的 WindowChrome.CaptionHeight=36 提供（无需 DragMove）
      - 双击最大化：MouseLeftButtonDown ClickCount==2
    -->
    <Border Background="{StaticResource BgSide}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PageNameText"
                       Grid.Column="0"
                       Style="{StaticResource BodyText}"
                       Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Path=PageTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinButton" Width="46" Height="36" Focusable="False"
                        Click="OnMinimize">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent">
                                <Path Data="M0,0 H10" Stretch="None"
                                      Stroke="{StaticResource Text}" StrokeThickness="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="MaxButton" Width="46" Height="36" Focusable="False"
                        Click="OnMaximize">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent">
                                <Path Data="M0,0 H10 V10 H0 Z" Stretch="None"
                                      Stroke="{StaticResource Text}" StrokeThickness="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="CloseButton" Width="46" Height="36" Focusable="False"
                        Click="OnClose">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent">
                                <Path x:Name="Glyph" Data="M0,0 L10,10 M10,0 L0,10" Stretch="None"
                                      Stroke="{StaticResource Text}" StrokeThickness="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource CloseHover}"/>
                                    <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
