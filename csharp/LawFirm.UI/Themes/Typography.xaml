<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      字号/字重（规格 §1.3：字体 "Microsoft YaHei UI" 基准 13px；对齐 style.py:87）。
    -->

    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <sys:Double x:Key="FontBaseSize">13</sys:Double>
    <sys:Double x:Key="FontCaptionSize">12</sys:Double>
    <sys:Double x:Key="FontPageTitleSize">20</sys:Double>
    <sys:Double x:Key="FontDialogTitleSize">15</sys:Double>

    <!-- 主文字（13px） -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBaseSize}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 次级说明文字（12px text_mute；对应 Python CaptionLabel） -->
    <Style x:Key="CaptionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontCaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMute}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 页标题 / tab 标题（20px 700；style.py:167,237-243） -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontPageTitleSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

</ResourceDictionary>
