<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Notion 浅色调色板（规格 §1.3，逐 token 抄录 app/ui/style.py:28-45 _light()）。
      后续深色皮肤只需新增 PaletteDark.xaml 覆盖同名 key（U12：Pilot 不做深色）。
    -->

    <!-- 底色 -->
    <SolidColorBrush x:Key="Canvas"     Color="#F7F6F3"/>  <!-- 内容区底色 -->
    <SolidColorBrush x:Key="BgSide"     Color="#F7F6F3"/>  <!-- 侧栏/标题栏底色 -->
    <SolidColorBrush x:Key="Bg"         Color="#FFFFFF"/>  <!-- 卡片/表格底色 -->
    <SolidColorBrush x:Key="BgTable"    Color="#FBFBFA"/>  <!-- 表头底/悬停提示底 -->
    <SolidColorBrush x:Key="BgHover"    Color="#EFEDEA"/>  <!-- hover 底 -->
    <SolidColorBrush x:Key="BgSelect"   Color="#E3E1DB"/>  <!-- 选中底 -->

    <!-- 描边 / 网格 -->
    <SolidColorBrush x:Key="Border"     Color="#E9E9E7"/>  <!-- 主分隔线 -->
    <SolidColorBrush x:Key="Border2"    Color="#DADAD7"/>  <!-- 控件描边 -->
    <SolidColorBrush x:Key="GridLine"   Color="#F1F1EF"/>  <!-- 表格网格线 -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text"       Color="#37352F"/>  <!-- 主文字 -->
    <SolidColorBrush x:Key="TextMute"   Color="#787774"/>  <!-- 次级文字 -->
    <SolidColorBrush x:Key="TextFaint"  Color="#9B9A97"/>  <!-- 三级文字（分组标题） -->

    <!-- 强调 -->
    <SolidColorBrush x:Key="AccentBlue" Color="#2EAADC"/>  <!-- 主按钮 / tab 下划线 -->
    <SolidColorBrush x:Key="BtnPriBg"   Color="#37352F"/>  <!-- 墨黑主按钮（备用 token） -->
    <SolidColorBrush x:Key="Red"        Color="#EB5757"/>  <!-- 负数红（table_view.py:18） -->

    <!-- 表格特殊底色（table_features.py:36,116,119） -->
    <SolidColorBrush x:Key="FrozenBg"       Color="#EAEAEA"/>  <!-- 冻结列底 -->
    <SolidColorBrush x:Key="HeaderSortBg"   Color="#E3F2FD"/>  <!-- 排序列表头底 -->
    <SolidColorBrush x:Key="HeaderFrozenBg" Color="#E0E0E0"/>  <!-- 冻结列表头底（略深于单元格灰） -->

    <!-- 标题栏关闭按钮 hover（main_window.py:169） -->
    <SolidColorBrush x:Key="CloseHover" Color="#E81123"/>

</ResourceDictionary>
