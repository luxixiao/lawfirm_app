<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LawFirm.UI.Controls">

    <!--
      表格基础设施专用样式（规格 §4.3 / §4.5）。
      由 App.xaml 合并（第 4 个字典）；被 T5.3 各表格页引用。
      两级表头模板约定（§4.3）：
      - DataGridColumn 挂 controls:TwoTierHeaderGrid.GroupLabel（大类起始列）/ .IsLead（整高列）；
      - 本类维护 Column.NextColumnWidth；模板经 MultiBinding(TwoTierWidthConverter) 得跨列宽。
    -->

    <controls:TwoTierWidthConverter x:Key="TwoTierWidth"/>
    <controls:IsNegativeConverter x:Key="IsNegative"/>

    <!-- 两级表头（总高 44 由 NotionDataGrid.ColumnHeaderHeight 设置；§4.3 第 2 步的 2 行 Grid） -->
    <Style x:Key="TwoTierColumnHeaderStyle" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource NotionColumnHeaderStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClipToBounds="False">
                        <Grid ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 第 1 行：大类（跨本列 + 右邻列，宽度经 converter 同步；U4 +2 补偿） -->
                            <TextBlock x:Name="GroupText" Grid.Row="0"
                                       Text="{Binding Path=Column.(controls:TwoTierHeaderGrid.GroupLabel), RelativeSource={RelativeSource TemplatedParent}}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       ClipToBounds="False">
                                <TextBlock.Width>
                                    <!-- QA M3：绑 SelfWidth/NextColumnWidth（attached DP，有变更通知），
                                         不绑 Column.ActualWidth（无通知，拖宽时大类文字不刷新） -->
                                    <MultiBinding Converter="{StaticResource TwoTierWidth}">
                                        <Binding Path="Column.(controls:TwoTierHeaderGrid.SelfWidth)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Column.(controls:TwoTierHeaderGrid.NextColumnWidth)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </TextBlock.Width>
                            </TextBlock>
                            <!-- 第 2 行：细分列名（子列）；整高列走 LeadContent -->
                            <ContentPresenter x:Name="SubContent" Grid.Row="1"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <!-- 整高列（序号/姓名）：跨两行居中 -->
                            <ContentPresenter x:Name="LeadContent" Grid.Row="0" Grid.RowSpan="2"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                        </Grid>
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper"
                               Style="{StaticResource HeaderGripperStyle}"
                               HorizontalAlignment="Right"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Column.(controls:TwoTierHeaderGrid.IsLead), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="LeadContent" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SubContent" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="GroupText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Column.(controls:TwoTierHeaderGrid.GroupLabel), RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="GroupText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 冻结列灰底单元格（#EAEAEA，table_features.py:36；选中仍保色 BgSelect） -->
    <Style x:Key="FrozenCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource NotionCellStyle}">
        <Setter Property="Background" Value="{StaticResource FrozenBg}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BgSelect}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      负数红：因 DataTrigger 需按列 key 绑定单元格值（{Binding [key]}），
      数字列的 ElementStyle 由 GridColumnFactory 代码构造（见 Controls/GridColumnFactory.cs），
      此处只提供转换器资源（IsNegative）。
    -->

</ResourceDictionary>
